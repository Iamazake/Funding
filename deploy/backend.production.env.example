# Production names and non-secret placeholders. Inject real secrets through
# the cloud secret manager; do not commit a populated copy.
APP_ENV=production
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=900
TRUSTED_HOSTS=DOMINIO
FRONTEND_BASE_URL=https://DOMINIO
CORS_ALLOWED_ORIGINS=
AUTH_SESSION_HOURS=8
AUTH_COOKIE_SECURE=true
ENABLE_API_DOCS=false
FUNDING_ALLOW_HISTORICAL_ALLOCATION_FOR_TESTS=false
OPERATIONAL_SOURCE=onedrive
OPERATIONAL_EXCEL_PATH=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_REDIRECT_URI=https://DOMINIO/api/integrations/onedrive/callback
ONEDRIVE_AUTHORITY=https://login.microsoftonline.com/consumers
ONEDRIVE_FILE_PATH=
ONEDRIVE_TOKEN_ENCRYPTION_KEY=
ONEDRIVE_OAUTH_STATE_MINUTES=10
FUNDING_BOOTSTRAP_ADMIN_NAME=
FUNDING_BOOTSTRAP_ADMIN_EMAIL=
FUNDING_BOOTSTRAP_ADMIN_PASSWORD=
