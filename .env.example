# Copy this file to .env and replace the placeholders locally.
# Never commit the real connection string.
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/postgres?ssl=require
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30
DB_POOL_RECYCLE_SECONDS=900

# Local path to the operational Cadastro de Clientes workbook.
# Configure the real Windows-compatible path only in the local .env.
OPERATIONAL_EXCEL_PATH=
OPERATIONAL_SOURCE=local

# OneDrive Personal (OAuth delegated, read-only). Never commit real values.
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_REDIRECT_URI=http://localhost:8000/api/integrations/onedrive/callback
FRONTEND_BASE_URL=http://localhost:5173
ONEDRIVE_AUTHORITY=https://login.microsoftonline.com/consumers
ONEDRIVE_FILE_PATH=
ONEDRIVE_TOKEN_ENCRYPTION_KEY=
# ONEDRIVE_OAUTH_STATE_MINUTES=10

# Authentication. Secure cookies default to true outside development/test.
AUTH_SESSION_HOURS=8
# Local HTTP only. Production rejects false.
AUTH_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=
TRUSTED_HOSTS=localhost,127.0.0.1
ENABLE_API_DOCS=true
FUNDING_ALLOW_HISTORICAL_ALLOCATION_FOR_TESTS=false

# Used only by: python -m app.cli bootstrap-admin
FUNDING_BOOTSTRAP_ADMIN_NAME=
FUNDING_BOOTSTRAP_ADMIN_EMAIL=
FUNDING_BOOTSTRAP_ADMIN_PASSWORD=
